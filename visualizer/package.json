{
  "name": "cells-visualizer",
  "version": "0.1.0",
  "private": true,
  "description": "3D viewer for the Cells architecture map and, later, experiment replays. Tooling: reads the checkout and saved run outputs; never part of the engine.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "extract": "python3 tools/extract_architecture.py",
    "import:proteins": "python3 tools/import_protein_inventory.py",
    "adapt:runs": "python3 tools/adapt_run.py",
    "check": "npm run extract -- --strict && npm test",
    "serve": "node tools/serve.mjs",
    "export": "node tools/export_page.mjs",
    "stage": "python3 tools/stage_publish.py",
    "shot": "node tools/screenshot.mjs",
    "check:input": "node tools/check_input.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:species": "node tools/check_species.mjs",
    "check:shelves": "node tools/check_shelves.mjs",
    "check:layers": "node tools/check_layers.mjs",
    "check:look": "node tools/check_look.mjs",
    "check:flux": "node tools/check_cellflux.mjs",
    "check:machine": "node tools/check_machine.mjs",
    "check:all": "node tools/check_all.mjs"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
