  "kinds": {
    "voltage-gated Na channel": {
      "district": "sodium",
      "site": "plasma",
      "cell_view": "cap.channels",
      "plain": "A sodium channel that opens when the membrane voltage rises. One long protein chain folds into four repeats around a single pore, and smaller beta subunits sit beside it.",
      "assembly": {
        "shape": "chain",
        "repeats": 4,
        "aux": [
          {
            "role": "beta",
            "side": "out",
            "count": 1,
            "when": "beta",
            "firm_if": null
          }
        ]
      },
      "expects": "^1 alpha"
    },
    "voltage-gated K channel": {
      "district": "potassium",
      "site": "plasma",
      "cell_view": "cap.channels",
      "plain": "A potassium channel that opens with the membrane voltage. Four subunits surround one pore.",
      "plain_generic": "A voltage-gated potassium current in a simple phenomenological form.",
      "assembly": {
        "shape": "ring",
        "subunits": 4,
        "aux": [
          {
            "role": "Kv-beta",
            "side": "in",
            "count": 4,
            "when": "Kv-beta",
            "firm_if": "\\+ 4 Kv-beta"
          }
        ]
      },
      "expects": "4 alpha",
      "neutral": {
        "shape": "pore"
      }
    },
    "inward-rectifier K channel": {
      "district": "potassium",
      "site": "plasma",
      "cell_view": "cap.channels",
      "plain": "A potassium channel that conducts best near the resting voltage and helps to hold the cell there. Four subunits surround one pore.",
      "assembly": {
        "shape": "ring",
        "subunits": 4
      },
      "expects": "^4 alpha"
    },
    "Ca-activated K channel": {
      "district": "potassium",
      "site": "plasma",
      "cell_view": "cap.channels",
      "plain": "A potassium channel opened by calcium inside the cell.",
      "neutral": {
        "shape": "pore"
      }
    },
    "HCN channel": {
      "district": "hcn",
      "site": "plasma",
      "cell_view": "cap.channels",
      "plain": "A channel that opens when the membrane voltage falls, and passes both potassium and sodium. Four subunits surround one pore.",
      "assembly": {
        "shape": "ring",
        "subunits": 4
      },
      "expects": "^4 alpha"
    },
    "background leak": {
      "district": "leaks",
      "site": "plasma",
      "cell_view": "cap.channels",
      "plain": "An always-open path for ions through the membrane: a background conductance.",
      "neutral": {
        "shape": "pore"
      }
    },
    "background permeability": {
      "district": "leaks",
      "site": "plasma",
      "plain": "A property of the membrane as a whole: how easily ions or water cross it. No protein population stands behind it.",
      "neutral": {
        "shape": "patch"
      }
    },
    "voltage-gated Ca channel (HVA)": {
      "district": "calcium",
      "site": "plasma",
      "cell_view": "cap.channels",
      "plain": "A calcium channel that opens at high voltage. One long chain folds into four repeats around the pore, with a beta subunit inside the cell and an alpha2-delta subunit outside.",
      "assembly": {
        "shape": "chain",
        "repeats": 4,
        "aux": [
          {
            "role": "beta",
            "side": "in",
            "count": 1,
            "when": "1 beta",
            "firm_if": "1 beta"
          },
          {
            "role": "alpha2delta",
            "side": "out",
            "count": 1,
            "when": "1 alpha2delta",
            "firm_if": "1 alpha2delta"
          }
        ]
      },
      "expects": "^1 alpha1 \\+ 1 beta \\+ 1 alpha2delta"
    },
    "voltage-gated Ca channel (LVA)": {
      "district": "calcium",
      "site": "plasma",
      "cell_view": "cap.channels",
      "plain": "A calcium channel that opens at low voltage (T-type). One long chain forms the pore on its own.",
      "assembly": {
        "shape": "chain",
        "repeats": 4
      },
      "expects": "^1 alpha1(?! \\+)"
    },
    "gap-junction channel": {
      "district": "junctions",
      "site": "junction",
      "cell_view": "cap.junctions",
      "plain": "A channel that joins two neighbouring cells, so ions and small molecules pass straight from one to the other. Each cell contributes a ring of six connexins.",
      "plain_generic": "A channel that joins two neighbouring cells, so ions and small molecules pass straight from one to the other.",
      "assembly": {
        "shape": "junction",
        "subunits": 6,
        "hetero_if": "6 Cx\\d+ \\+ 6 Cx\\d+"
      },
      "expects": "2 x 6|6 Cx\\d+ \\+ 6 Cx\\d+",
      "neutral": {
        "shape": "junction"
      }
    },
    "P-type ATPase": {
      "district": "pumps",
      "site": "plasma",
      "cell_view": "cap.pumps",
      "plain": "A pump: it spends ATP to move ions against their gradient.",
      "neutral": {
        "shape": "pump"
      }
    },
    "secondary transporter": {
      "district": "transporters",
      "site": "plasma",
      "plain": "An exchanger: it moves one ion uphill by letting another run downhill.",
      "neutral": {
        "shape": "carrier"
      }
    },
    "secondary transporter (SLC12)": {
      "district": "transporters",
      "site": "plasma",
      "plain": "A cotransporter: it carries chloride together with potassium, or with sodium and potassium, and moves no net charge.",
      "neutral": {
        "shape": "carrier"
      }
    },
    "configured transporter": {
      "district": "transporters",
      "site": "plasma",
      "plain": "A transporter that each model configuration declares: its stoichiometry and identity come from the configuration.",
      "neutral": {
        "shape": "carrier"
      }
    },
    "intracellular release channel": {
      "district": "er",
      "site": "er",
      "cell_view": "cap.calcium",
      "plain": "A channel in the ER membrane that releases stored calcium into the cell.",
      "neutral": {
        "shape": "pore",
        "wide": true
      }
    },
    "organelle permeability": {
      "district": "mitochondria",
      "site": "mito",
      "cell_view": "cap.mitochondria",
      "plain": "The passive permeability of the mitochondrial inner membrane, lumped into one term.",
      "neutral": {
        "shape": "patch"
      }
    },
    "protein assembly": {
      "district": "assembly",
      "site": "cytoplasm",
      "cell_view": "cap.assembly",
      "plain": "An engineered protein cage: 60 subunits in 20 three-part units, which assemble into a closed shell.",
      "assembly": {
        "shape": "cage",
        "trimers": 20
      },
      "expects": "20 trimers \\(60 subunits\\)"
    }
  },
