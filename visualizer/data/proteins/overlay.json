{
  "format": "cells.visualizer.protein_atlas_overlay@1",
  "title": "Protein atlas",
  "summary": "The molecular machines Cells models: its own inventory, linked to the public protein atlases.",
  "caveat": "Shapes are schematic, drawn from subunit counts, and not to scale. A grey form is a generic law: no protein is assigned.",
  "plan": {
    "path": "docs/PROTEIN_CATALOGUE_PLAN.md",
    "where": "What the engine models today (stage 2 inventory)"
  },
  "links": {
    "uniprot": {
      "text": "UniProt {id}",
      "url": "https://www.uniprot.org/uniprotkb/{id}/entry"
    },
    "alphafold": {
      "text": "AlphaFold DB",
      "url": "https://alphafold.ebi.ac.uk/entry/{id}"
    },
    "hpa": {
      "text": "Human Protein Atlas",
      "url": "https://www.proteinatlas.org/search/{id}"
    },
    "rcsb": {
      "text": "RCSB PDB",
      "url": "https://www.rcsb.org/structure/{id}"
    },
    "pubmed": {
      "text": "PubMed",
      "url": "https://pubmed.ncbi.nlm.nih.gov/{id}/"
    },
    "doi": {
      "text": "Paper",
      "url": "https://doi.org/{id}"
    }
  },
  "alphafold_longest": 2700,
  "renamed": {
    "bitsey_emt_pair@1": {
      "to": "emt_mirna_pair@1",
      "source": "docs/PROTEIN_CATALOGUE_PLAN.md"
    }
  },
  "mappings": [
    {
      "id": "assigned",
      "inventory": "assigned in source",
      "label": "Assigned in source",
      "description": "The law, its documents or the source it cites names the protein. This records a label; the kind of evidence on each law says what stands behind it.",
      "note": ""
    },
    {
      "id": "candidate",
      "inventory": "candidate",
      "label": "Candidate",
      "description": "The law models a named native current or channel class. Which gene products carry it is the inventory's inference.",
      "note": "Which protein carries this current is the inventory's inference. The shape drawn is the candidate's."
    },
    {
      "id": "generic",
      "inventory": "generic, isoform not assigned",
      "label": "Generic",
      "description": "The law is deliberately generic, phenomenological or manufactured. Products are listed as candidates only.",
      "note": "The law is generic: it names no protein. The grey form is a plain stand-in, and any products below are candidates only."
    }
  ],
  "evidence": [
    {
      "id": "expressed isoform",
      "label": "Expressed isoform",
      "description": "The cited data come from the named isoform, expressed on its own."
    },
    {
      "id": "isoform named in title",
      "label": "Isoform named in the title",
      "description": "The cited source names the isoform in its title; the inventory read no further detail."
    },
    {
      "id": "native current",
      "label": "Native current",
      "description": "The cited data are a current recorded from native cells, not from an isolated isoform."
    },
    {
      "id": "neuron model",
      "label": "Neuron model",
      "description": "The cited source is a model of a neuron."
    },
    {
      "id": "derived reduction",
      "label": "Derived reduction",
      "description": "A reduced (Morris-Lecar) form of the named channel."
    },
    {
      "id": "designed protein",
      "label": "Designed protein",
      "description": "An engineered protein with no natural gene product."
    },
    {
      "id": "no detail in source",
      "label": "No detail in the source",
      "description": "The source gives no detail on what the coefficients were measured from."
    }
  ],
