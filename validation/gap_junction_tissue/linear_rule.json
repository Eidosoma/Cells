 "mapping": {
  "rule": "an engine arm is compared with the reference network named by its `network`; a chain's Norton conductance and intercept with the reference chain of its n",
  "engine to reference": "the same id without the as-written prefix 'aw-'; both planted controls with figure3-g1, the unperturbed network",
  "cells": "by id, never by position: the engine's concentrations are in its network's cell order, which the declaration lists"
 },
 "error_terms": {
  "unit_roundoff": 1.1102230246251565e-16,
  "transient": "A exp(-K_dec T) x 1.01, A = sqrt(N V_max/V_min) rho",
  "rounding": "4u (rho/(K_dec dt) + (1 + G_max)(1 + rho) + 1)",
  "ledger": "2u N (T/S)",
  "reference": "each value's declared accuracy_rel, at most 1e-13"
 },
 "norton": {
  "judged_step": "dt (the step rule's)",
  "concentration_tolerance": "F_N (transient + rounding) + accuracy_rel",
  "factor_of_safety": 2.0,
  "steady": "the relative change over the last S <= F_N (transient + rounding)",
  "ledger": "|ledger flux - G_probe (c - held)| / |G_probe (c - held)| <= F_N ledger + 2 (c / |c - held|) F_N (transient + rounding)",
  "chains": "G and the intercept from the two loads, first-order propagation of the concentrations' floor and the fluxes' (ledger + the concentration's share)"
 },
 "as_written": {
  "steps": "dt, dt/2, dt/4",
  "judged_step": "dt/4",
  "estimate": "max over cells |c(dt/2) - c(dt/4)| / |c(dt/4)| / (2^p - 1), p = 2",
  "order_declared": 2,
  "order_reason": "Strang's split of the reactions' SSPRK(3,3) halves about @3's ARS(2,2,2) step (resolved_pump_composite@1): second order",
  "tolerance": "max(F_W est, floor) + accuracy_rel, F_W = 3 (Roache's two-grid factor at an assumed order, as FR-25), floor = the Norton floor at dt/4",
  "factor_of_safety": 3.0,
  "order_window": [
   1.5,
   3.5
  ],
  "at_floor": "where F_W est <= floor the arm is judged against the floor and the order check is skipped",
  "chains": "G and the intercept at each step from its two loads, by the same rule"
 },
 "verdicts": {
  "arm": "inconclusive if an order falls outside the window; else failed if any judged quantity exceeds its tolerance or the engine refused the run; else passed",
  "plants": "each planted control must fail by its gap (it ran, and its gap exceeds its tolerance); a plant that passes, is missing, refused or inconclusive makes the comparison 'instrument not validated', whatever the other arms show",
  "overall": "any failed arm makes the comparison failed; else any inconclusive arm makes it inconclusive; else passed (FR-25's precedence, D308)"
 },
 "retry": {
  "fractions": [
   0.5,
   0.25,
   0.125
  ],
  "judged_fraction": 0.125,
  "once": true,
  "arms": "inconclusive as-written arms only",
  "harness": "a run stopped by the harness (memory, runtime limit, machine fault) is rerun once from the same snapshot; an engine refusal is a result, never rerun",
  "driver": "run.py takes the triple from the step rule's dt and runs every arm: a retry needs a tagged amendment adding the finer base step and the arm filter before it runs (D308)"
 },
