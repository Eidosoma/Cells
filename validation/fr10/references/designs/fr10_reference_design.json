  "path": "validation/fr10/references/reference_inputs.json",
  "source": "branch fr10-protocol, commit cbe4f27d, validation/bath_schedule/reference_inputs.json (copied byte for byte)",
  "git_blob": "9236a0a722c96056d941feb54885824452b5f59a"
 },
 "constants": {
  "faraday_C_per_mol": "96485.3321233100184",
  "gas_constant_J_per_mol_K": "8.31446261815324",
  "RT_J_per_mol_at_310K": "2577.4834116275044",
  "thermal_voltage_V_at_310K": "0.026713733112650050044357343935649981523822422690506"
 },
 "min_margin": 10.0,
 "readings": [
  "Inputs are the exact values of the file's doubles; constants are the exact SI values the file states (F = N_A e, R = N_A k_B), never Appendix A's rounded RT and F.",
  "Events are right-continuous: the bath's composition at t_e is the new one; amounts and V_m are continuous, so a record at t_e has one value.",
  "dG_b's ln(a_s/V_b) is the log of the mM number (standard state 1 mM). A different standard state or a dropped -1 shifts dG_b by a multiple of sum_s dn_s, so W2 (sum_s dn_s = 0) has no power against either; W1 and W3 do.",
  "K(t) needs S_s at every event time: every event time must be a record time (to 1e-12 s), else the call is refused; nothing is interpolated.",
  "K from the engine's own supply checks the reconciliation's arithmetic only; it has no power against a wrong supply. K from the reference supply (R-faces, R-ion) does.",
  "R-ion's zero-current potential after the step has two readings: (a) at the cytosol's composition at t_e with the new bath (the Nernst potential), and (b) the epoch's own limit, where the charge that depolarises the wall has also moved K into the cytosol. They differ by about 1.2e-7 V; both are returned, labelled.",
  "W1's supply is the finite nodes' gain, S(t) = sum_i (n_i(t) - n_i(0)); W2's is the cell's gain, S_s(t) = -(n_s(t) - n_s(0)), positive out of the bath."
 ],
 "claims": {
  "R-faces (B1, A.2)": {
   "quantity": "S amount (fmol) at each finite node at each record time; the supply S(t)",
   "reference": "exact per epoch: symmetrised eigendecomposition of the deviation from the epoch's steady state c_b",
   "second_method": "scipy expm of the augmented generator, chained independently; a 50-digit Sylvester form for two nodes (tests)",
   "floor_max_fmol": 7.546047120499111e-17,
   "decimal_vs_primary_max_fmol": 3.469446951953614e-18,
   "tolerance_basis": "pinned by the protocol from its dt study, with power at a dt only when tau(dt) <= ceiling(dt) (the smallest control deviation / min_margin) and tau(dt) >= min_margin x floor; an honest second-order engine is expected near the stand-ins' bracket (power.W1)",
   "order": "an honest second-order engine's error falls about 4x per halving of dt; the late, early and half-step controls and implicit Euler fall 2x"
  },
  "R-ion (B2, A.3)": {
   "quantity": "V_m (V) and the cytosol's Na, K and Cl (fmol) at each record time; the zero-current potential after the step, readings (a) and (b)",
   "reference": "the scalar equation on the charge invariant, DOP853 at rtol 3e-14, epoch by epoch",
   "second_method": "Radau on the full state (rtol 1e-12) and QUADPACK's time residual |f(V) (T(V) - t)|; the floor is the larger",
   "floor_max_V": 1.904709345263805e-14,
   "floor_max_fmol": 1.4210854715202004e-14,
   "impermeant_species": "Na, Cl and S are constant: P = 0, so any change fails",
   "tolerance_basis": "as R-faces, per dt (power.W2). Appendix A's rounded constants would move V_m by power.W2.rounded_constants; a V_m tolerance has power against them only below rounded_constants_needs_tolerance_V",
   "relaxation_left_at_end_V": -2.827068787403242e-11
  },
  "R-records (B4, A.4, A.5, \u00a72.2, \u00a72.3)": {
   "quantity": "per event: dose per species (fmol), dG_b (pJ), the step's charge (C); K(t) (pJ) from a supply series",
   "reference": "exact rationals for the dose and charge; dG_b and K in 50-digit decimals",
   "second_method": "float64 evaluations of the same forms (K in the operator's B form)",
   "tolerance_basis": "dG_b within 1e-12 relative (the protocol's criterion; the floor is below 1e-15 relative); dose and K at rounding (a few ulps of their magnitudes); a neutral step's charge is exactly 0 in rationals",
   "floor_max_relative_dG_b": 5.246959599582987e-16
  }
 },
