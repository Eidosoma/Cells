 },
 "items": {
  "Q1": {
   "claim": "Every @3 ledger closes across replacement events with the replacement terms, on host (surface_pump.checked_rows) and device (surface_pump_checks.row_checks), for one, simultaneous, both-ends, second-generation and donor-copy events.",
   "cases": "all W7 and C9 cases of the predictions, plus W37 (validation/tissue/cell_replacement_cost.py swap world, 3000 steps)",
   "pass": "no ledger, domain or dissipation check fails on any accepted row, on host or device"
  },
  "Q2": {
   "claim": "The engine's event map equals R-ops on each case's first event set applied to the declared initial state.",
   "compared": "slot amounts, slot channel gates, incident junction gates, removed, supplied, replacement charge, image charge at held nodes, booked free energy",
   "pass": "within 64 eps x magnitude per quantity (amounts and gates exact to rounding)"
  },
  "Q3": {
   "claim": "After events, trajectories agree with R-full.",
   "compared": "every cell's Vm and the replaced slots' amounts at every 0.1 s record over 10 s",
   "cases": "W7 and C9, three formation rules",
   "pass": "within the pinned tolerance at every record"
  },
  "Q4": {
   "claim": "On the ungated chain C9, Vm after replacement agrees with the reduced chain R-fast, and the end state (D or H of every cell at 10 s) is the same.",
   "cases": "C9 isolated template and donor copy, three formation rules",
   "pass": "Vm within the pinned tolerance (reduction term included) at every record; identical end-state classification (threshold the U state, -39.45 mV)"
  },
  "Q5": {
   "claim": "Newcomer trajectories converge with the split's observed order (formation half-steps around ARS(2,2,2)).",
   "cases": "W7 short-lag and C9 isolated short-lag (amendment A3)",
   "method": "dt 2, 1, 0.5, 0.25 ms; D(h) = max over the records after the first event of |slot Vm(h) - slot Vm(h/2)|; order log2(D(1 ms) / D(0.5 ms)) (amendment A3)",
   "registered_before_A3": "dt 5, 2, 1, 0.5 ms on W7 short-lag and C9 donor short-lag, Richardson order from errors against 0.5 ms at 2 and 1 ms",
   "pass": "observed order between 1.8 and 2.2"
  },
  "Q6": {
   "claim": "Restart at t_e - dt, t_e and t_e + dt is bitwise; vmap cohorts of 2 and 8 worlds with different schedules reproduce their scalar runs.",
   "pass": "bitwise for restart; within 1e-12 relative per state field for vmap"
  },
  "Q7": {
   "claim": "Without events the model equals resolved_pump_tissue@3 bitwise on the 825-node world.",
   "pass": "bitwise on every @3 state field, observation and check diagnostic over 200 steps (detached driver)"
  }
 },
