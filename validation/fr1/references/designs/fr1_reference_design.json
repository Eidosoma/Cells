  "path": "validation/fr1/references/reference_inputs.json",
  "source": "branch fr1-protocol, commit f78dacb9 (unchanged since cf61c252), validation/closed_compartment/reference_inputs.json (copied byte for byte)",
  "git_blob": "d4becd3fa40e5571e3118584f6e35c8d429c9b59"
 },
 "constants": {
  "faraday_C_per_mol": "96485.3321233100184",
  "gas_constant_J_per_mol_K": "8.31446261815324",
  "RT_pJ_per_fmol_at_310K": "2.5774834116275044"
 },
 "min_margin": 10.0,
 "settled_readings": [
  {
   "reading": "1. A.4's comparison 'to rounding'",
   "settled": "the inputs fix the plan S(h) = E(h/2) I(h) E(h/2), S(dt/2) twice per step (convention 6). The floor is the float64 moved-form iteration's distance from the 50-digit map; the registered rounding allowance is 4 ulps of N per stage, accumulated (power.C4_step_map)"
  },
  {
   "reading": "2. A.5's units",
   "settled": "the inputs declare a = 2.0000000000000004e-4 fmol/s = A V_max with V_max in fmol/s/m^2, and b = 5e-4 fmol = K_M V_o; both are used as declared and checked against their parameters to 1e-14"
  },
  {
   "reading": "3. A.7's standard potentials",
   "settled": "C7 declares none, and R_energy does not ask for C7's energy: no reaction work is computed"
  },
  {
   "reading": "4. A.8's face",
   "settled": "C8 declares no face to a bath: the uptake path is the closed three-node chain"
  },
  {
   "reading": "5. A.9's orientation",
   "settled": "the inputs' R_capacitor names V_b = phi_i - phi_j and V_pm = phi_i - phi_b, as this package computes them"
  },
  {
   "reading": "6. A declared rate beside its parameters",
   "settled": "kappa_per_s is used as declared (19.999999999999996 and 1.9999999999999998, the doubles of 1e15 k_u A/V) and checked against 1e15 k_u A/V of the import's source to 1e-14; a mismatch is refused"
  },
  {
   "reading": "7. The splitting term",
   "settled": "the inputs' returns line reads 'x* - x_eq beside -a(a + 2b) dt^2/96'; the design's wording since 4adb6fed names the relative displacement, x*/x_eq - 1 = -a(a + 2b) dt^2/96 (\u00a72.3). Both are returned: the relative displacement meets the leading term (ratio 1 - O(dt)), the absolute one is x_eq times it"
  },
  {
   "reading": "8. C7's moiety",
   "settled": "S + P over the cytosol's S and the compartment's S and P; P's cytosolic row is untouched and is reported as its own constant"
  },
  {
   "reading": "9. Energy along a trajectory",
   "settled": "dG(t) is the change of G over the two nodes the law touches, evaluated per node as a stable increment from the declared start, in decimals, with RT = 1e-3 R T pJ/fmol from the exact SI R"
  }
 ],
 "claims": {
  "C3 (A.2)": {
   "quantity": "each node's S at every record time, flux and first-order loading",
   "reference": "exact rationals (flux); 50-digit decimals (first-order)",
   "second_method": "float64 with expm1",
   "tolerance_basis": "the engine equals the closed form to rounding: the registered allowance is 8 ulps of the total amount per step, accumulated (power.C3_C4_C5_closed_forms)"
  },
  "C4 (A.3, A.4)": {
   "quantity": "each node's S at every record time; x_eq; at each rung the map's x*, x(t), the amounts, and the splitting term",
   "reference": "A.3 in decimals; A.4's map iterated in 50-digit decimals",
   "second_method": "SciPy expm (A.3); the float64 moved-form iteration (A.4)",
   "tolerance_basis": "against the closed form: the dt study's tolerance, which an honest map meets at its own O(dt^2) distance (power.C4_step_map.per_rung.honest_map_vs_closed_form_fmol); against the map: rounding, 4 ulps of N per stage; the splitting term: the relative displacement over -a(a + 2b) dt^2/96 = 1 - O(dt)"
  },
  "C5 (A.5)": {
   "quantity": "each node's S at every record time",
   "reference": "Newton on the implicit form in 50-digit decimals",
   "second_method": "Wright's omega (SciPy)",
   "tolerance_basis": "the protocol pins it; the controls' deviations and the rounding allowance are in power.C3_C4_C5_closed_forms"
  },
  "C6, C7, C8 (A.6, A.7, A.8)": {
   "quantity": "each node's S (C7's P at the compartment) at every record time; C6's cleared amount; C7's moiety",
   "reference": "50-digit matrix exponential",
   "second_method": "SciPy expm",
   "tolerance_basis": "the protocol's dt study; an honest split engine's distance is bracketed by the Lie and Strang stand-ins at the declared dt, and the ceiling is the smallest control's deviation / 10 (power.C6_C7_C8_linear)"
  },
  "C9 (A.9)": {
   "quantity": "V_b and V_pm from the charges",
   "reference": "exact rationals",
   "second_method": "NumPy's dense solve",
   "tolerance_basis": "rounding; V_b = -q_j/C_b exactly, so a silent compartment's V_b is 0"
  },
  "C10, C11 (A.10)": {
   "quantity": "dG of the nodes each law touches at every record time; G",
   "reference": "stable per-node increments in 50-digit decimals",
   "second_method": "float64 of the same increments",
   "tolerance_basis": "the protocol's (RK4's absolute 2e-8 pJ, the NumPy dG test); the floor is below 1e-16 pJ"
  }
 },
