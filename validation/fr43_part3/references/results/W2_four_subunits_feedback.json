 "method": {
  "values_from": "the closed form at 50 significant digits (decimal arithmetic), rounded to binary64",
  "closed_form": {
   "law": "between events N is constant and x' = A x + p, A = [[-a, b], [a, -(b + k)]], a = G/V_cell, b = G/V_node, p = (P_cell, 0); x(tau) = e^{A tau} x0 + tau phi1(A tau) p and int_0^tau x = tau phi1(A tau) x0 + tau^2 phi2(A tau) p by Sylvester's formula on the eigenvalues of A (A = diag(0, -k) when G = 0); H, the transferred, produced and cleared amounts are linear in int x",
   "arithmetic": "Python decimal at 50 significant digits; declared values and draws enter as their exact binary64 values; E_k = -ln(u1_k) at that precision",
   "event_location": "bracketed, safeguarded Newton on H(tau) - E_k (H' = a0 > 0), stopped at |delta tau| <= 1e-45 s (relative to max(1, tau)); hazard residual at each event in diagnostics",
   "channel_rule": "the spec's rule at the crossing state in exact arithmetic, and in binary64 with the nextafter guard as a check (diagnostics: channel_float_agrees)"
  },
  "ode": {
   "integrator": "scipy.integrate.solve_ivp Radau, rtol 1e-12, atol 1e-15, the Jacobian of the affine right-hand side exact from unit vectors",
